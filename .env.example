# 示例环境变量配置模板 (公共模板，请勿在此填写真实密钥)
# 复制此文件为 .env 并在本地填写真实 API Key

# 具生涌动提供商密钥与端点示例
JUSHENG_API_KEY=sk-your-jusheng-api-key-here
JUSHENG_BASE_URL=http://8.148.249.98:88/

# 本地 Antigravity 代理提供商示例
ANTIGRAVITY_API_KEY=your-antigravity-api-key-here
ANTIGRAVITY_BASE_URL=https://antigravitycli.niuzhidao.cc/

# 其他可选提供商
